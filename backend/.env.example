# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pintuweb

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-at-least-32-chars-long-change-this
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Razorpay (UPI recharge) ───────────────────────────────────────────────────
# Same keys as PintuV3 bot .env
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Public website URL for post-payment redirect (no trailing slash)
FRONTEND_URL=http://localhost:3000
# Public URL of this API (for payment webhooks — must be HTTPS in production)
API_PUBLIC_URL=http://localhost:8000

# ── NOWPayments (crypto recharge) ─────────────────────────────────────────────
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_BASE_CURRENCY=usd
# Set true while testing with NOWPayments sandbox
NOWPAYMENTS_SANDBOX=false

# ── OAuth (website login) ─────────────────────────────────────────────────────
# Google Cloud Console → OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=
# Same token as PintuV3 TELEGRAM_BOT_TOKEN — verifies Telegram Login Widget
TELEGRAM_BOT_TOKEN=

# ── LLM ───────────────────────────────────────────────────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/HauhauCS/Qwen3.5-27B-Uncensored-HauhauCS-Aggressive:Q4_K_M
OLLAMA_CHAT_MAX_CONTEXT=500

# ── Chat pricing ──────────────────────────────────────────────────────────────
CHAT_CREDITS_PER_MESSAGE=0.2

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:3005"]

# ── File limits ───────────────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=10
DATA_DIR=data

# ── Cloudflare R2 (leave blank in dev — falls back to local disk) ─────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pintuweb-media
# If you have a public CDN on the bucket, set this (else presigned URLs are used)
R2_PUBLIC_URL=

# ── ComfyUI pods — JSON dict mapping pod name to URL ─────────────────────────
# Example with 2 pods:
# COMFYUI_PODS={"i2i-pod": "http://1.2.3.4:8188", "i2v-pod": "http://5.6.7.8:8188"}
COMFYUI_PODS={"local": "http://localhost:8188"}

# ── Worker settings ───────────────────────────────────────────────────────────
# Set per-pod; determines which pod claims which job and log attribution
POD_ID=local
WORKER_JOB_TYPES=["i2i","i2v","i2i_custom","i2v_custom","random_ai"]
WORKER_POLL_INTERVAL_SECS=3
JOB_LOCK_TTL_SECS=300
JOB_MAX_DURATION_SECS=600

# ── Service API token (Telegram bot uses this to call the backend) ────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SERVICE_API_TOKEN=

# ── Telegram delivery (worker → bot push, set on EACH pod) ───────────────────
# The worker calls this URL when a job completes, so the bot can immediately
# deliver the result to Telegram instead of polling.
# URL of bot's delivery server (must be reachable from the pod).
# Example: http://my-home-server:8001/internal/deliver
BOT_DELIVERY_URL=
# Shared secret — must match BOT_DELIVERY_SECRET in the bot's .env
BOT_DELIVERY_SECRET=

# Telegram bot Mini App server (template catalog + workflow builder)
# EC2: http://127.0.0.1:8081 — public: https://bot.krewbay.in
BOT_WEBAPP_BASE_URL=
# Optional override; defaults to SERVICE_API_TOKEN
BOT_SERVICE_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# EXAMPLE CONFIGS FOR YOUR 2 VAST.AI PODS
# ─────────────────────────────────────────────────────────────────────────────

# -- GPU 1: I2V pod (.env on that pod) ----------------------------------------
# DATABASE_URL=postgresql+asyncpg://pintuweb:pass@<mac-ip>:5432/pintuweb
# POD_ID=i2v-pod-1
# WORKER_JOB_TYPES=["i2v","i2v_custom"]
# COMFYUI_PODS={"i2v-pod-1": "http://localhost:8188"}
# BOT_DELIVERY_URL=http://<bot-host>:8001/internal/deliver
# BOT_DELIVERY_SECRET=<same-as-bot>
# JOB_MAX_DURATION_SECS=900

# -- GPU 2: I2I + LLM pod (.env on that pod) ----------------------------------
# DATABASE_URL=postgresql+asyncpg://pintuweb:pass@<mac-ip>:5432/pintuweb
# POD_ID=i2i-pod-1
# WORKER_JOB_TYPES=["i2i","i2i_custom","random_ai"]
# COMFYUI_PODS={"i2i-pod-1": "http://localhost:8188"}
# OLLAMA_URL=http://localhost:11434
# BOT_DELIVERY_URL=http://<bot-host>:8001/internal/deliver
# BOT_DELIVERY_SECRET=<same-as-bot>
# JOB_MAX_DURATION_SECS=300
